    <script>
        function toggleRegistration() {
            const btn = document.querySelector('.registration-btn');
            const status = document.querySelector('.registration-status');
            const spotsCount = document.querySelector('.spots-count');
            
            if (btn.classList.contains('registered')) {
                // Unregister
                btn.classList.remove('registered');
                btn.innerHTML = '✓ S\'inscrire gratuitement';
                status.classList.remove('registered');
                status.querySelector('.registration-status-icon').textContent = '🎫';
                status.querySelector('.registration-status-text').textContent = 'Inscription ouverte';
                
                // Update spots
                const [current, total] = spotsCount.textContent.split(' / ').map(Number);
                spotsCount.textContent = `${current + 1} / ${total}`;
            } else {
                // Register
                btn.classList.add('registered');
                btn.innerHTML = '✓ Inscrit';
                status.classList.add('registered');
                status.querySelector('.registration-status-icon').textContent = '✅';
                status.querySelector('.registration-status-text').textContent = 'Vous êtes inscrit';
                
                // Update spots
                const [current, total] = spotsCount.textContent.split(' / ').map(Number);
                spotsCount.textContent = `${current - 1} / ${total}`;
            }
        }

        // Gallery lightbox
        document.querySelectorAll('.gallery-item').forEach(item => {
            item.addEventListener('click', function() {
                alert('Lightbox à implémenter - Afficher l\'image en grand');
            });
        });

        // Share buttons
        document.querySelectorAll('.share-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.classList.contains('link')) {
                    navigator.clipboard.writeText(window.location.href);
                    alert('Lien copié dans le presse-papiers !');
                } else {
                    alert('Partage sur les réseaux sociaux à implémenter');
                }
            });
        });

        // Contact organizer
        document.querySelector('.contact-btn').addEventListener('click', function() {
            alert('Formulaire de contact à implémenter');
        });

        // Comment form
        document.querySelector('.comment-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const textarea = this.querySelector('.comment-input');
            if (textarea.value.trim()) {
                alert('Commentaire publié : ' + textarea.value);
                textarea.value = '';
            }
        });

        // Participants hover effect with names
        document.querySelectorAll('.participant-avatar').forEach(avatar => {
            avatar.addEventListener('mouseenter', function() {
                // Could show a tooltip with full name and info
            });
        });
