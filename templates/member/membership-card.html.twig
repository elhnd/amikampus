    <script>
        function flipCard() {
            const card = document.getElementById('membershipCard');
            card.classList.toggle('flipped');
        }

        // Auto-rotate card on page load (optional)
        setTimeout(() => {
            // Uncomment to auto-flip on load
            // flipCard();
        }, 1000);

        // Calculate days remaining
        function calculateDaysRemaining() {
            const expiryDate = new Date('2025-12-31');
            const today = new Date();
            const diffTime = expiryDate - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            // Update in UI if needed
            console.log('Days remaining:', diffDays);
            
            // Change status based on days remaining
            const statusIndicator = document.querySelector('.status-indicator');
            const statusTitle = document.querySelector('.status-title');
            const statusSubtitle = document.querySelector('.status-subtitle');
            const renewButton = document.querySelector('.renew-button');
            
            if (diffDays < 0) {
                // Expired
                statusIndicator.classList.remove('expiring');
                statusIndicator.classList.add('inactive');
                statusTitle.textContent = 'Carte Expirée';
                statusSubtitle.textContent = 'Veuillez renouveler votre adhésion';
                renewButton.disabled = false;
                renewButton.innerHTML = '<span>🔄</span><span>Renouveler maintenant</span>';
            } else if (diffDays <= 30) {
                // Expiring soon
                statusIndicator.classList.add('expiring');
                statusTitle.textContent = 'Expire Bientôt';
                statusSubtitle.textContent = `Plus que ${diffDays} jours restants`;
                renewButton.disabled = false;
                renewButton.innerHTML = '<span>🔄</span><span>Renouveler en avance</span>';
            }
        }

        // Run on page load
        calculateDaysRemaining();

        // Download receipt
        document.querySelectorAll('.action-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.textContent.includes('Télécharger')) {
                    alert('Téléchargement du reçu en cours...');
                } else if (this.textContent.includes('email')) {
                    alert('Reçu envoyé par email à {{ member.email }}');
                }
            });
        });

        // Renew button
        document.querySelector('.renew-button').addEventListener('click', function() {
            if (!this.disabled) {
                // Redirect to payment page
                alert('Redirection vers la page de paiement...');
            }
        });
    </script>
